{
  "name": "gamez-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"PB,ADMIN,WEB\" -c \"magenta,blue,yellow\" \"cd Admin && .\\pocketbase.exe serve\" \"npm run dev --workspace=Admin\" \"npm run dev --workspace=Website\"",
    "install:all": "npm install"
  },
  "workspaces": [
    "Admin",
    "Website"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  }
}
